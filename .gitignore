# ==========================================
# R SPECIFIC FILES
# ==========================================
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*.rda
*.rds
.renv/

# ==========================================
# ENVIRONMENT MANAGEMENT
# ==========================================
renv/
venv/
env/

# ==========================================
# DATA FILES (Open Science: Se ignoran bases pesadas)
# ==========================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Datos binarios y pesados de Stata, R, SPSS y Excel
*.dta
*.sav
*.csv
*.xlsx
!data/metadata/
!data/metadata/*.csv

# ==========================================
# OUTPUT FILES (Permitir sincronización con Overleaf)
# ==========================================
# Se ignoran formatos temporales o pesados de salida
output/*.html
output/*.xlsx
output/*.csv

# PERMITIR explícitamente código LaTeX (.tex) y gráficos (.pdf / .png)
!output/
!output/*.gitkeep
!output/**/*.tex
!output/**/*.pdf
!output/**/*.png

# ==========================================
# GENERATED BUILD FILES AND LOGS
# ==========================================
/main.log
/proc_rojas_murua_vicente.log
/logs/*.log
/latex/*.aux
/latex/*.bbl
/latex/*.bcf
/latex/*.blg
/latex/*.log
/latex/*.run.xml
/latex/*.synctex.gz

# ==========================================
# STATA & OS SPECIFIC
# ==========================================
*.gph
*.stsem
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/