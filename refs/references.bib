@article{Nessieretal2026,
  title = {Comportamientos y Estrategias de Consumo Alimentario En Tiempos de Inflaci\'on. {{Una}} Aproximaci\'on Regional En {{Argentina}}.},
  author = {Nessier, Mar{\'i}a Celeste and Zapata, Mar{\'i}a Elisa and Boragnio, Aldana and Knopof, Edgardo and Marconi, Agustina and Zamora, Rafael},
  year = 2026,
  journal = {Revista de Salud P\'ublica},
  volume = {32},
  number = {1},
  abstract = {INTRODUCTION: RISING FOOD PRICES AFFECT THE HUMAN RIGHT TO ADEQUATE FOOD. THE AIM OF THIS STUDY IS TO DESCRIBE AND EXAMINE ASSOCIATIONS BETWEEN FOOD-RELATED COPING STRATEGIES DURING PERIODS OF INFLATION ACROSS DIFFERENT REGIONS OF ARGENTINA.\textexclamdown BR /\textquestiondown{} METHODS: AN OBSERVATIONAL, ANALYTICAL, CROSS-SECTIONAL STUDY WAS CONDUCTED AMONG THE URBAN POPULATION OF ARGENTINA. A SELF-ADMINISTERED ONLINE SURVEY WAS DISTRIBUTED DURING NOVEMBER AND DECEMBER 2023 TO COLLECT INFORMATION ON SOCIODEMOGRAPHIC CHARACTERISTICS AND FOOD-RELATED STRATEGIES ADOPTED IN RESPONSE TO RISING FOOD PRICES. MULTIVARIABLE LOGISTIC REGRESSION MODELS WERE USED TO EXPLORE ASSOCIATIONS BETWEEN SKIPPING MEALS OR REDUCING FOOD PURCHASES AND SOCIODEMOGRAPHIC FACTORS, INCLUDING REGION, AGE, SEX, EDUCATIONAL LEVEL, AND HOUSEHOLD SUBSIDIES RECEIVED.\textexclamdown BR /\textquestiondown{} RESULTS: A TOTAL OF 3,596 RESPONSES WERE OBTAINED. THE NORTHEAST (NEA, ACRONYM IN SPANISH) AND CUYO REGIONS SHOWED THE GREATEST IMPACT ON FOOD CONSUMPTION STRATEGIES IN RESPONSE TO RISING FOOD PRICES. A DIRECT ASSOCIATION WAS FOUND BETWEEN FOOD INSECURITY VARIABLES AND SOCIODEMOGRAPHIC CONDITIONS, AS WELL AS RECEIVING GOVERNMENT ASSISTANCE/SUBSIDIES. SKIPPING BREAKFAST, LUNCH, OR DINNER WAS DIRECTLY ASSOCIATED WITH ALL VARIABLES STUDIED, WHEREAS REDUCING THE PURCHASE OF CERTAIN FOOD WAS SIGNIFICANTLY ASSOCIATED WITH THE PRESENCE OF CHILDREN UNDER 18 YEARS OF AGE IN THE HOUSEHOLD AND WITH RECEIVING GOVERNMENT PLANS, ASSISTANCE, OR SUBSIDIES.\textexclamdown BR /\textquestiondown{} CONCLUSIONS: FOOD-RELATED COPING STRATEGIES IN RESPONSE TO INFLATION VARY IN INTENSITY ACROSS REGIONS OF THE COUNTRY AND ADD TO PRE-EXISTING TERRITORIAL INEQUALITIES THAT AFFECT THE RIGHT TO ADEQUATE FOOD.},
  keywords = {01_Incluir,04_Incluir_Definitivo},
}

