@article{OliveiraOsorioGonner2022,
  title = {Change and Continuity between Chile Solidario and Ingreso Etico Familiar},
  author = {Oliveira, Maria Clara and Osorio Gonnet, Cecilia},
  year = 2022,
  month = jan,
  journal = {Rev. Adm. P\'ublica},
  volume = {56},
  number = {1},
  doi = {10.1590/0034-761220210046},
  abstract = {THIS ARTICLE PRESENTS AND DISCUSSES THE TWO CONDITIONAL CASH TRANSFER INITIATIVES IMPLEMENTED IN CHILE - CHILE SOLIDARIO (2002-2013) AND INGRESO ETICO SOLIDARIO (2013-PRESENT) - AND AIM AT IDENTIFYING CONTINUITIES AND CHANGE BETWEEN THE TWO. A COMPARISON OF THE TWO PROGRAMMES, BASED ON HOWLETT AND CASHORE'S (2009) TIPOLOGY FOR ANALYSING POLICY CHANGE THAT DISTINGUISHED BETWEEN ENDS AND MEANS, ALLOWS THE IDENTIFICATION OF CONTINUITIES AND CHANGES REGARDING THE GOALS AND MECHANISMS PRESENT IN THE TWO PROGRAMMES. THE ARTICLE ARGUES THAT DESPITE BEING ANNOUNCED AS AN INNOVATIVE MEASURE IN REGARD TO THE PREVIOUS PROGRAMME, INGRESO ETICO FAMILIAR MAINTAINS THE CORE CHARACTERISTICS OF CHILE SOLIDARIO AND INCLUDES SOME ADDITIONAL ELEMENTS. THIS ARTICLE MAKES TWO DIFFERENT CONTRIBUTIONS: (1) IT TRACES THE EVOLUTION OF CONDITIONAL CASH TRANSFERS PROGRAMMES IN CHILE OVER THE PAST TWO DECADES AND (2) IT ESTABLISHES A DIALOGUE WITH THE LITERATURES ON CHANGES TO SOCIAL POLICY.},
  keywords = {01_Incluir,04_Incluir_Definitivo,05_Politicas},
  file = {C\:\\Users\\vroja\\Zotero\\storage\\EH8IAGC8\\download (13).pdf;C\:\\Users\\vroja\\Zotero\\storage\\IYPPELF4\\Oliveira y Osorio Gonnet - 2022 - Change and continuity between chile solidario and ingreso etico familiar.pdf}
}

@article{OrnellasMauriel2025,
  title = {Basic Income and Solidarity Economy: {{The}} Experiences of Social Currencies in the State of Rio de Janeiro/Brazil},
  author = {Ornellas Mauriel, Ana Paula},
  year = 2025,
  journal = {REVISTA RUPTURAS},
  volume = {15},
  doi = {10.22458/rr.v15i2.5993},
  abstract = {THE TEXT, BASED ON ONGOING RESEARCH, AIMS TO DISCUSS RECENT EXPERIENCES OF CASH TRANSFER PROGRAMS USING SOCIAL CURRENCIES IN CITIES ACROSS THE STATE OF RIO DE JANEIRO. MONETARY TRANSFERS THROUGH SOCIAL CURRENCIES, CREATED TO MITIGATE THE EFFECTS OF THE COVID-19 PANDEMIC WHILE MANAGING LOCAL POLICIES, REFLECT THE VALUES AND INSTITUTIONAL DYNAMICS SHAPED BY LOCAL POLITICS-OFTEN MARKED BY CONSERVATISM-AND THE CONTRADICTIONS INHERENT IN BRAZIL'S OWN EXPERIENCE WITH CASH TRANSFERS. THESE PROGRAMS HAVE BEEN IMPLEMENTED AS A SUBSTITUTE FOR BROADER AND MORE STRUCTURAL RIGHTS, CREATING TENSIONS WITH THE BASIC INCOME PERSPECTIVE IN A CONTEXT OF SIGNIFICANT SETBACKS IN RIGHTS AND MATERIAL LIVING CONDITIONS.},
  keywords = {01_Incluir,04_Incluir_Definitivo,05_Politicas}
}

@article{Painteretal2020,
  title = {Skin Tone and Asset Inequality in Latin America},
  author = {Painter II, Matthew A. and Noy, Shiri and Holmes, Malcolm D.},
  year = 2020,
  journal = {JOURNAL OF ETHNIC AND MIGRATION STUDIES},
  volume = {46},
  doi = {10.1080/1369183X.2019.1592881},
  abstract = {MUCH OF OUR INFORMATION ABOUT THE RELATIONSHIP BETWEEN SKIN TONE, RACE/ETHNICITY, AND WEALTH INEQUALITY CENTERS ON THE U.S. CONTEXT. LATIN AMERICA, CHARACTERISED BY THE HIGHEST LEVELS OF INEQUALITY GLOBALLY AND DISTINCTIVE RACIAL/ETHNIC HIERARCHIES, PROVIDES A UNIQUE OPPORTUNITY TO EXTEND OUR UNDERSTANDING OF THESE DYNAMICS. DRAWING ON SOCIOCOGNITIVE THEORIES AND THE PREFERENCE FOR WHITENESS HYPOTHESIS, THIS STUDY USES UNIQUE LAPOP DATA FROM 18 COUNTRIES TO EXAMINE THE RELATIONSHIP BETWEEN SKIN TONE, RACE/ETHNICITY, AND WEALTH INEQUALITY IN LATIN AMERICA. WE USE THREE MEASURES OF WEALTH, FOCUSING ON ASSETS WHICH YIELD EXTENSIVE INDIVIDUAL ADVANTAGES: HOMES, CARS, AND MOTORCYCLES. RESULTS FROM LOGISTIC REGRESSION MODELS SUGGEST THAT DARKER SKIN SHADES HINDER INDIVIDUALS' ABILITY TO ACQUIRE VEHICLES BUT IS LESS IMPORTANT FOR HOMEOWNERSHIP. OUR RESULTS FOR CAR OWNERSHIP BEST MAP ONTO THE THEORETICAL EXPECTATIONS FOR HOW SKIN TONE MIGHT MATTER FOR ASSET ACQUISITION IN LATIN AMERICA. HOWEVER, WE ALSO FIND NOTABLE VARIATION ACROSS COUNTRIES THAT MERITS FURTHER CROSS-NATIONAL EXPLORATION. WE CONCLUDE BY DISCUSSING FRUITFUL DIRECTIONS FOR FUTURE RESEARCH.},
  keywords = {01_Incluir,04_Incluir_Definitivo}
}

