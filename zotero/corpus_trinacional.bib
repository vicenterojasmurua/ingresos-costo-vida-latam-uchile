@article{WOS000484034300001,
  author = {NEIDHOEFER GUIDO and NINO-ZARAZUA MIGUEL},
  title = {{THE LONG(ER)-TERM IMPACTS OF CHILE SOLIDARIO ON HUMAN CAPITAL AND LABOR INCOME}},
  journal = {POPULATION AND DEVELOPMENT REVIEW},
  year = {2019},
  volume = {45},
  number = {},
