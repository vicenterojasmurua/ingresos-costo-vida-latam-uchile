@article{WOS001592926800010,
  author = {CATALAN TOMAS TAPIA and MARCHANT SANTIAGO CARLA},
  title = {{SEASONAL MIGRATIONS AND GLOBAL EXPORTS: DYNAMICS OF TEMPORARY EMPLOYMENT IN SOUTHERN CHILE}},
  journal = {RIVAR-REVISTA IBEROAMERICANA DE VITICULTURA AGROINDUSTRIA Y RURALIDAD},
  year = {2025},
  volume = {12},
  number = {},
  doi = {10.35588/ms6ak334},
  abstract = {THE GLOBAL DYNAMICS OF IMPORTING AND EXPORTING FRESH PRODUCE GENERATE SEASONAL MIGRATORY FLOWS OF TEMPORARY WORKERS. THESE MOVEMENTS IMPACT THE SOCIOECONOMIC CONDITIONS OF THE POPULATIONS INVOLVED, LEADING TO POVERTY, INFORMAL LABOR, AND FAMILY BREAKDOWN. THE RESEARCH FOCUSES ON SOUTHERN CHILE, ANALYZING SEASONAL MIGRATIONS STEMMING FROM BLUEBERRY AND SALMON PRODUCTION IN THE LOS RIOS AND LOS LAGOS REGIONS, COMMODITIES OF SIGNIFICANCE TO THE REGIONAL AND NATIONAL ECONOMY. THE STUDY AIMS TO UNDERSTAND THE SEASONAL MIGRATIONS OF TEMPORARY WORKERS BY EXAMINING THEIR SOCIOECONOMIC COMPOSITIONS, SPATIAL EXPRESSIONS, AND SOCIOHISTORICAL TRANSFORMATIONS LINKED TO THESE INDUSTRIES. PRIMARY SOURCES, SUCH AS SEMI-STRUCTURED INTERVIEWS, AND SECONDARY SOURCES, INCLUDING AGRICULTURAL AND AQUACULTURAL REGISTRIES, WERE UTILIZED. FINDINGS REVEAL DISTINCT SOCIOECONOMIC GROUPS, DIVERSE SPATIAL AND SOCIAL NETWORKS, AND TRANSFORMATIONS TIED TO THE TEMPORALITY OF MIGRATORY MOVEMENTS. THE RESEARCH ACKNOWLEDGES THE UNIQUE CONTEXT OF SOUTHERN CHILE, FRAMING MIGRATION WITHIN A SPECIFIC GEOGRAPHIC AND ECONOMIC SETTING, THEREBY ILLUSTRATING HOW GLOBAL ECONOMIC DYNAMICS MANIFEST HETEROGENEOUSLY IN LOCAL AND RURAL CONTEXTS.}
}

@article{WOS001669864200002,
  author = {GERI MILVA and MANZANO FERNANDO ARIEL},
  title = {{SILVER ECONOMY IN ARGENTINA: OPPORTUNITY OR MIRAGE?}},
  journal = {PAPELES DE POBLACION},
  year = {2026},
  volume = {32},
  number = {},
  doi = {10.22185/24487147.2026.121.06},
  abstract = {INTRODUCTION: THE SILVER ECONOMY PROPOSES CONSIDERING PEOPLE AGED 50 OR OLDER AS A POTENTIAL DEMAND CAPABLE OF DRIVING ECONOMIC GROWTH. STUDYING THE FEASIBILITY OF ADOPTING THIS PARADIGM IN ARGENTINA IS THE MOTIVATION OF THIS WORK. DEVELOPMENT: ALTHOUGH THERE IS DEMOGRAPHIC POTENTIAL IN ARGENTINA TO TAKE ADVANTAGE OF THE SILVER ECONOMY (EVOLUTION OF LIFE EXPECTANCY AT BIRTH AND PROPORTION OF PEOPLE OVER 50 YEARS OF AGE IN ALL REGIONS OF THE COUNTRY), THE RESOURCES TO FINANCE THE CONSUMPTION OF THESE GENERATIONS ARE NOT ASSURED. THIS IS DOCUMENTED BY ANALYZING THE RECENT EVOLUTION OF THE POSSIBLE SOURCES OF FINANCING THE CONSUMPTION OF THIS AGE GROUP (DISSAVINGS, SALARY AND SOCIAL SECURITY BENEFITS). CONCLUSIONS: IN ARGENTINA, A TRADITIONAL NEGATIVE VIEW OF AGING STILL PERSISTS AND THERE ARE NO SIGNS THAT THIS NEW PARADIGM CAN BE IMPORTED FROM EUROPEAN COUNTRIES, UNLESS THE TREND OF LOSS OF PURCHASING POWER OF OLDER ADULTS CHANGES.}
}

@article{WOS000402691700001,
  author = {BERTHELON MATIAS and KRUGER DIANA I and EBERHARD JUAN P},
  title = {{ESTIMATING THE EFFECTS OF TEEN MOTHERHOOD IN CHILE: A FAMILY FIXED EFFECTS APPROACH}},
  journal = {ESTUDIOS DE ECONOMIA},
  year = {2017},
  volume = {44},
  number = {},
  doi = {},
  abstract = {WE STUDY THE EFFECT OF ADOLESCENT MOTHERHOOD ON EDUCATION AND LABOR OUTCOMES AMONG 20-24 YEAR OLD WOMEN IN CHILE. WE IDENTIFY CAUSAL EFFECTS OF MOTHERHOOD WITH FAMILY FIXED EFFECTS USING A LARGE DATA SET COVERING THE 1990-2011 PERIOD. TEEN MOTHERHOOD HAS NEGATIVE EFFECTS ON EDUCATION AND LABOR OUTCOMES, AND TIMING OF MOTHERHOOD MATTERS: TEEN BIRTHS REDUCE EDUCATION OUTCOMES, WHILE YOUNG MOTHERHOOD REDUCES LABOR FORCE PARTICIPATION. LABOR OUTCOME EFFECTS ARE PRESENT AMONG THE NON POOR, AND EFFECTS CHANGED BETWEEN 1990 AND 2011. RESULTS HIGHLIGHT THE IMPORTANT ROLE OF ADOLESCENT MOTHERHOOD IN WOMEN'S HUMAN CAPITAL ACCUMULATION AND INCOME INEQUALITY.}
}

@article{WOS000352082800015,
  author = {BIGOTTA MAURIZIO and KRISHNAKUMAR JAYA and RANI UMA},
  title = {{FURTHER RESULTS ON THE REGRESSION-BASED APPROACH TO INEQUALITY DECOMPOSITION WITH EVIDENCE FROM INDIA}},
  journal = {EMPIRICAL ECONOMICS},
  year = {2015},
  volume = {48},
  number = {},
  doi = {10.1007/s00181-014-0819-5},
  abstract = {THE PAPER REVISITS REGRESSION-BASED INEQUALITY DECOMPOSITION, DERIVES FURTHER THEORETICAL RESULTS ON THE FACTOR SHARES AND APPLIES THEM IN AN EMPIRICAL SETTING. NOTING THAT THE APPROACH BASED ON SHORROCKS AND FIELDS IS NOT DIRECTLY APPLICABLE TO AN IMPORTANT WELFARE-BASED INEQUALITY INDEX, NAMELY ATKINSON'S INEQUALITY INDEX, WE GENERALISE IT TO DERIVE SHARES FOR THIS INDEX. WE ALSO DERIVE THE ASYMPTOTIC DISTRIBUTION OF ALL SHARE ESTIMATORS FOR OBTAINING THEIR STANDARD ERRORS NECESSARY FOR DRAWING INFERENCE. FINALLY, WE USE OUR THEORETICAL RESULTS TO EXAMINE THE MAJOR FACTORS THAT CONTRIBUTE TO INCOME INEQUALITY IN INDIA. OUR RESULTS SHOW THAT EDUCATION AND HOUSEHOLD SIZE ARE THE TWO MOST DOMINANT FACTORS CONTRIBUTING TO INCOME INEQUALITY IN BOTH RURAL AND URBAN AREAS, FOLLOWED BY EMPLOYMENT STATUS AND REGIONAL DIFFERENCES.}
}

